 "imitation_notes": [
  {
   "icons": "automation-read",
   "idea": "A wave line is the curve; the small forward triangle under it says it plays back.",
   "convention": "A curve for automation is common. The triangle is the generic play shape."
  },
  {
   "icons": "automation-write",
   "idea": "The same wave with a solid dot: the dot says it records into the curve.",
   "convention": "Dot for record is generic. The wave and dot pairing is not a standard."
  },
  {
   "icons": "automation-touch",
   "idea": "The wave with an open ring: a contact that exists only while you hold a control.",
   "convention": "None known."
  },
  {
   "icons": "automation-latch",
   "idea": "The wave with a ring crossed by a bar: the value is held after you let go.",
   "convention": "None known."
  },
  {
   "icons": "selector",
   "idea": "A rectangle whose four corners are marked: a region you mark out.",
   "convention": "A dashed or cornered marquee is the common selection symbol."
  },
  {
   "icons": "zoom, zoom-in, zoom-out, zoom-selection, search",
   "idea": "A round lens with a handle; a bar, plus, small box or a centre dot inside says which zoom it is.",
   "convention": "The magnifier with plus and minus is near universal."
  }
 ],
 "conventional_shapes": "play, stop, pause, record, rewind, fast-forward, to-start and loop (generic transport shapes); lock (padlock); folder; hidden (eye with a slash); undo and redo (curved arrows); warning (triangle), info (circle with i), error (circle with x), success (circle with check); close; overflow (three dots); disclosure arrows; mute (speaker with x); monitor (headphones); bypass (power symbol); grabber (four-way arrows); pencil; assistant (speech bubble); settings (sliders)."
}